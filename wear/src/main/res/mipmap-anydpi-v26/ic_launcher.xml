<?xml version="1.0" encoding="utf-8"?>
<!-- Wear OS launcher icon: the same syringe + drop mark on forest green as the Play Store
     listing icon (store_assets/icons/icon_512.png), so the installed watch icon matches the
     store listing. Wear launchers mask adaptive icons to a circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
